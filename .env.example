# Copy to .env and fill in. Every variable the app reads is listed here.

# Prisma / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/idea_app

# NextAuth: public base URL of the app and a random secret (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth client (sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Break-glass local admin account (username "admin"); leave empty to disable
LOCAL_ADMIN_PASSWORD=

# Shared secret required in the x-cron-secret header for POST /api/cron/weekly-summary
CRON_SECRET=

# Weekly summary e-mail: service account with Gmail domain-wide delegation and the mailbox it sends as
NOTIFIER_SA_EMAIL=<SA_EMAIL>
GMAIL_SENDER=noreply@example.com

# Cloud Storage uploads (src/lib/storage.ts)
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
GCS_BUCKET=<BUCKET>
